{"id": "g01", "domain": "nat", "statement": "∀ (n : Nat), n + 0 = n", "reference_proof": "intro n\nrfl", "note": "加零，定义上成立"}
{"id": "g02", "domain": "nat", "statement": "∀ (n : Nat), n * 0 = 0", "reference_proof": "intro n\nrfl", "note": "乘零，定义上成立"}
{"id": "g03", "domain": "nat", "statement": "∀ (n : Nat), 0 + n = n", "reference_proof": "intro n\nsimp", "note": "零加，需归纳"}
{"id": "g04", "domain": "nat", "statement": "∀ (n : Nat), n * 1 = n", "reference_proof": "intro n\nsimp", "note": "乘一"}
{"id": "g05", "domain": "nat", "statement": "∀ (n : Nat), 1 * n = n", "reference_proof": "intro n\nsimp", "note": "一乘"}
{"id": "g06", "domain": "nat", "statement": "∀ (n : Nat), n + 0 = 0 + n", "reference_proof": "intro n\nsimp", "note": "两侧零"}
{"id": "g07", "domain": "nat", "statement": "∀ (a b : Nat), a + b = b + a", "reference_proof": "intro a b\nexact Nat.add_comm a b", "note": "加法交换律（核心库）"}
{"id": "g08", "domain": "nat", "statement": "∀ (a b : Nat), a * b = b * a", "reference_proof": "intro a b\nexact Nat.mul_comm a b", "note": "乘法交换律"}
{"id": "g09", "domain": "nat", "statement": "∀ (a b c : Nat), a + b + c = a + (b + c)", "reference_proof": "intro a b c\nexact Nat.add_assoc a b c", "note": "加法结合律"}
{"id": "g10", "domain": "nat", "statement": "∀ (a b c : Nat), a * b * c = a * (b * c)", "reference_proof": "intro a b c\nexact Nat.mul_assoc a b c", "note": "乘法结合律"}
{"id": "g11", "domain": "nat", "statement": "∀ (a b c : Nat), a * (b + c) = a * b + a * c", "reference_proof": "intro a b c\nexact Nat.mul_add a b c", "note": "左分配律"}
{"id": "g12", "domain": "nat", "statement": "∀ (a b c : Nat), (a + b) * c = a * c + b * c", "reference_proof": "intro a b c\nexact Nat.add_mul a b c", "note": "右分配律"}
{"id": "g13", "domain": "nat", "statement": "∀ (a : Nat), a + a = 2 * a", "reference_proof": "intro a\nring", "note": "ring 在半环上可用"}
{"id": "g14", "domain": "nat", "statement": "∀ (a : Nat), a ^ 2 = a * a", "reference_proof": "intro a\nring", "note": "幂展开"}
{"id": "g15", "domain": "nat", "statement": "∀ (a b : Nat), (a + b) ^ 2 = a ^ 2 + 2 * a * b + b ^ 2", "reference_proof": "intro a b\nring", "note": "二项式展开（ℕ）"}
{"id": "g16", "domain": "nat", "statement": "∀ (n : Nat), n < n + 1", "reference_proof": "intro n\nomega", "note": "严格单调"}
{"id": "g17", "domain": "nat", "statement": "∀ (n : Nat), n ≤ n + 1", "reference_proof": "intro n\nomega", "note": "非严格"}
{"id": "g18", "domain": "nat", "statement": "∀ (n : Nat), 0 ≤ n", "reference_proof": "intro n\nexact Nat.zero_le n", "note": "ℕ 非负"}
{"id": "g19", "domain": "nat", "statement": "∀ (n : Nat), n ≤ n + n", "reference_proof": "intro n\nomega", "note": "加倍不小于自身"}
{"id": "g20", "domain": "nat", "statement": "∀ (n : Nat), n ≤ n * n + 1", "reference_proof": "intro n\nhave h : n ≤ n * n := Nat.le_mul_self n\nomega", "note": "平方放缩（需要引理）"}
{"id": "g21", "domain": "nat", "statement": "∀ (a b : Nat), a ≤ b → a ≤ b + 1", "reference_proof": "intro a b h\nomega", "note": "传递加一"}
{"id": "g22", "domain": "nat", "statement": "∀ (a b : Nat), a < b → a ≤ b", "reference_proof": "intro a b h\nomega", "note": "严格转非严格"}
{"id": "g23", "domain": "nat", "statement": "(2 : Nat) ∣ 4", "reference_proof": "norm_num", "note": "闭式整除"}
{"id": "g24", "domain": "nat", "statement": "(3 : Nat) ∣ 12", "reference_proof": "norm_num", "note": "闭式整除"}
{"id": "g25", "domain": "nat", "statement": "(6 : Nat) ∣ 24", "reference_proof": "norm_num", "note": "闭式整除"}
{"id": "g26", "domain": "nat", "statement": "∀ (a : Nat), a ∣ a * a", "reference_proof": "intro a\nexact ⟨a, rfl⟩", "note": "自整除（给见证）"}
{"id": "g27", "domain": "nat", "statement": "∀ (a b : Nat), a ∣ a * b", "reference_proof": "intro a b\nexact ⟨b, rfl⟩", "note": "整除乘积"}
{"id": "g28", "domain": "nat", "statement": "∀ (a b : Nat), b ∣ a * b", "reference_proof": "intro a b\nexact ⟨a, by ring⟩", "note": "另一侧整除"}
{"id": "g29", "domain": "nat", "statement": "∀ (n : Nat), 3 ∣ n * 3", "reference_proof": "intro n\nexact ⟨n, by ring⟩", "note": "整倍数"}
{"id": "g30", "domain": "nat", "statement": "∀ (a : Nat), a ∣ 0", "reference_proof": "intro a\nexact dvd_zero a", "note": "零被整除"}
{"id": "g31", "domain": "nat", "statement": "∀ (a : Nat), a ∣ a", "reference_proof": "intro a\nexact dvd_rfl", "note": "自反"}
{"id": "g32", "domain": "nat", "statement": "∀ (n : Nat), 1 ∣ n", "reference_proof": "intro n\nexact one_dvd n", "note": "1 整除一切"}
{"id": "g33", "domain": "nat", "statement": "∀ (n : Nat), 0 ∣ n → n = 0", "reference_proof": "intro n h\nobtain ⟨c, hc⟩ := h\nsimpa using hc", "note": "0 只能整除 0"}
{"id": "g34", "domain": "nat", "statement": "∀ (n : Nat), Even (n * (n + 1))", "reference_proof": "intro n\nexact Nat.even_mul_succ_self n", "note": "相邻整数之积为偶（Mathlib）"}
{"id": "g37", "domain": "nat", "statement": "∀ (n : Nat), n + 0 = n ∧ n * 0 = 0", "reference_proof": "intro n\nconstructor\n· rfl\n· rfl", "note": "合取目标"}
{"id": "g38", "domain": "nat", "statement": "∀ (n : Nat), n ≤ n * n + 1 ∧ n < n + 1", "reference_proof": "intro n\nconstructor\n· have h : n ≤ n * n := Nat.le_mul_self n\n  omega\n· omega", "note": "合取 + 两个不同难度分量"}
{"id": "g39", "domain": "prop", "statement": "∀ (P : Prop), P → P", "reference_proof": "intro P h\nexact h", "note": "恒等"}
{"id": "g40", "domain": "prop", "statement": "∀ (P Q : Prop), P ∧ Q → Q ∧ P", "reference_proof": "intro P Q h\nconstructor\n· exact h.2\n· exact h.1", "note": "合取交换"}
{"id": "g41", "domain": "prop", "statement": "∀ (P Q : Prop), P ∧ Q → P", "reference_proof": "intro P Q h\nexact h.1", "note": "合取消去"}
{"id": "g42", "domain": "prop", "statement": "∀ (P Q : Prop), P → P ∨ Q", "reference_proof": "intro P Q h\nleft\nexact h", "note": "析取引入"}
{"id": "g43", "domain": "prop", "statement": "∀ (P Q : Prop), Q → P ∨ Q", "reference_proof": "intro P Q h\nright\nexact h", "note": "析取引入（右）"}
{"id": "g44", "domain": "prop", "statement": "∀ (P Q : Prop), P ∨ Q → Q ∨ P", "reference_proof": "intro P Q h\ncases h with\n| inl hp => exact Or.inr hp\n| inr hq => exact Or.inl hq", "note": "析取交换"}
{"id": "g45", "domain": "prop", "statement": "∀ (P Q R : Prop), (P → Q) → (Q → R) → P → R", "reference_proof": "intro P Q R h1 h2 h3\nexact h2 (h1 h3)", "note": "传递"}
{"id": "g46", "domain": "prop", "statement": "∀ (P : Prop), False → P", "reference_proof": "intro P h\nexact False.elim h", "note": "爆炸原理"}
{"id": "g47", "domain": "prop", "statement": "∀ (P : Prop), P → ¬ ¬ P", "reference_proof": "intro P h hh\nexact hh h", "note": "双重否定引入"}
{"id": "g48", "domain": "prop", "statement": "∀ (P : Prop), ¬ ¬ (P ∨ ¬ P)", "reference_proof": "intro P h\napply h\nright\nintro hp\napply h\nleft\nexact hp", "note": "排中律的双否形式（构造性可证）"}
{"id": "g49", "domain": "prop", "statement": "∀ (P Q : Prop), (P → Q) → ¬ Q → ¬ P", "reference_proof": "intro P Q hpq hnq hp\nexact hnq (hpq hp)", "note": "逆否"}
{"id": "g50", "domain": "prop", "statement": "∀ (P : Prop), P ↔ P", "reference_proof": "intro P\nconstructor\n· intro h\n  exact h\n· intro h\n  exact h", "note": "等价自反"}
{"id": "g51", "domain": "type", "statement": "∀ (α : Type) (a b : α), a = b → b = a", "reference_proof": "intro α a b h\nexact h.symm", "note": "等式对称"}
{"id": "g52", "domain": "type", "statement": "∀ (α : Type) (a b c : α), a = b → b = c → a = c", "reference_proof": "intro α a b c h1 h2\nexact h1.trans h2", "note": "等式传递"}
{"id": "g53", "domain": "type", "statement": "∀ (α : Type) (a : α), a = a", "reference_proof": "intro α a\nrfl", "note": "等式自反"}
{"id": "g54", "domain": "real", "statement": "∀ (x : ℝ), x + 0 = x", "reference_proof": "intro x\nring", "note": "ℝ 加零"}
{"id": "g55", "domain": "real", "statement": "∀ (x : ℝ), x - x = 0", "reference_proof": "intro x\nring", "note": "ℝ 自减"}
{"id": "g56", "domain": "real", "statement": "∀ (x y : ℝ), x + y = y + x", "reference_proof": "intro x y\nring", "note": "ℝ 加法交换"}
{"id": "g57", "domain": "real", "statement": "∀ (x y : ℝ), (x + y) ^ 2 = x ^ 2 + 2 * x * y + y ^ 2", "reference_proof": "intro x y\nring", "note": "ℝ 二项式展开"}
{"id": "g58", "domain": "real", "statement": "∀ (x : ℝ), (x + 1) ^ 2 = x ^ 2 + 2 * x + 1", "reference_proof": "intro x\nring", "note": "ℝ 二项式（特例）"}
{"id": "g59", "domain": "real", "statement": "∀ (x : ℝ), x ^ 2 ≥ 0", "reference_proof": "intro x\nexact sq_nonneg x", "note": "平方非负"}
{"id": "g60", "domain": "real", "statement": "∀ (x : ℝ), 0 ≤ x ^ 2 + 1", "reference_proof": "intro x\nnlinarith [sq_nonneg x]", "note": "平方加一为正"}
{"id": "g61", "domain": "real", "statement": "∀ (x : ℝ), x < x + 1", "reference_proof": "intro x\nlinarith", "note": "线性算术"}
{"id": "g62", "domain": "real", "statement": "∀ (x y : ℝ), x ≤ y → x ≤ y + 1", "reference_proof": "intro x y h\nlinarith", "note": "线性算术（带假设）"}
{"id": "g63", "domain": "real", "statement": "∀ (x : ℝ), |x| ≥ 0", "reference_proof": "intro x\nexact abs_nonneg x", "note": "绝对值非负"}
{"id": "g64", "domain": "int", "statement": "∀ (a b : ℤ), a + b = b + a", "reference_proof": "intro a b\nring", "note": "ℤ 加法交换"}
{"id": "g65", "domain": "int", "statement": "∀ (n : ℤ), n * 0 = 0", "reference_proof": "intro n\nring", "note": "ℤ 乘零"}
