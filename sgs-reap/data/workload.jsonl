{"id": "w01", "domain": "nat", "statement": "∀ (n : Nat), n + 0 = n", "note": "命题核心：加零。n + 0 定义上就是 n，一行 rfl 可解"}
{"id": "w02", "domain": "nat", "statement": "∀ (n : Nat), n * 0 = 0", "note": "乘法递归在第二参数上，rfl 可解"}
{"id": "w03", "domain": "nat", "statement": "∀ (n : Nat), n + 1 = n + 1", "note": "自反等式，作为最弱基线"}
{"id": "w04", "domain": "nat", "statement": "∀ (n : Nat), (n + 1) * 0 = 0", "note": "复合项上的乘零"}
{"id": "w05", "domain": "nat", "statement": "∀ (a b : Nat), a + b = b + a", "note": "交换律；核心库有 Nat.add_comm，非 rfl"}
