# 复制为 .env 后填写；.env 不入库
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选调参（proxy.py 读取，均为进程环境变量）
# DISABLE_THINKING=1          # deepseek-flash 关闭思考后单次调用 ~83 token（开启时 3k–10k）
# CONJECTURE_MAX_TOKENS=16384
# GUIDE_MAX_TOKENS=16384
# CONJECTURE_TEMPERATURE=1.0
# GUIDE_TEMPERATURE=0.0       # Guide 稳定性优先
